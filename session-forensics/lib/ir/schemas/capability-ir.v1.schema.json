{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/capability-ir/v1",
  "title": "专属能力中间表示 v1",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "title", "summary", "steps", "provenance", "evaluation", "fingerprint"],
  "properties": {
    "schemaVersion": { "const": "capability-ir/v1" },
    "id": { "type": "string" },
    "version": { "type": "string" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "triggers": { "type": "array", "items": { "type": "string" } },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["id", "instruction", "evidenceRefs", "onFailure"],
      "properties": {
        "id": { "type": "string" },
        "instruction": { "type": "string" },
        "toolContract": { "type": "object" },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "confidence": { "type": "object" },
        "onFailure": { "type": "string" }
      }
    }
  }
}
