# The API only listens on 127.0.0.1. Keep credentials in .env, never in the browser.
KOLFORGE_PORT=8798
KOLFORGE_DATA_DIR=E:\kolforge-data
# Per-channel ceiling for the "as many as possible" discovery mode (30-20000).
# The default full batch is 15000 per channel. Results remain identity-deduplicated.
KOLFORGE_MAX_DISCOVERY_PER_CHANNEL=15000
# Search routes per platform (1-16). The default checkpoints 16 distinct
# routes, then combines and deduplicates the discovered accounts.
KOLFORGE_DISCOVERY_QUERY_VARIANTS=16
# Extra public-card headroom used to offset account duplicates across routes.
# The collector redistributes this budget after every route and skips remaining
# routes as soon as a channel reaches its unique-account target (1.00-3.00).
KOLFORGE_DISCOVERY_ROUTE_OVERFETCH_RATIO=1.35
# Browser Relay stays bounded for a live logged-in session. Default: 30 minutes
# per checkpointed route; valid range: 120000-4200000 milliseconds.
KOLFORGE_BROWSER_RELAY_COLLECTION_TIMEOUT_MS=1800000
# Per-creator public-profile content bounds. The default continues until the
# relay observes page exhaustion or reaches the 10,000-card safety ceiling.
# Reaching the ceiling is recorded as resumable coverage, not full history.
KOLFORGE_MAX_CONTENT_SAMPLES_PER_CREATOR=10000
KOLFORGE_DEFAULT_CONTENT_SAMPLES_PER_CREATOR=10000
# Creator collection workers (1-4). Browser Relay page work remains globally
# serial; this only overlaps non-browser connectors and per-creator artifact work.
KOLFORGE_CONTENT_COLLECTION_CONCURRENCY=2
KOLFORGE_CONTENT_PERSISTENCE_WORKERS=4

# Optional model-backed content analysis. Leave these settings blank to use the
# deterministic evidence matrix. The local Ollama path is localhost-only and
# executes one evidence-grounded role at a time to keep GPU use bounded.
# KOLFORGE_CONTENT_ANALYSIS_PROVIDER=ollama
# KOLFORGE_CONTENT_ANALYSIS_OLLAMA_MODEL=qwen2.5vl:3b
# KOLFORGE_CONTENT_ANALYSIS_OLLAMA_BASE_URL=http://127.0.0.1:11434
# KOLFORGE_CONTENT_ANALYSIS_TIMEOUT_MS=90000
# KOLFORGE_CONTENT_ANALYSIS_CONTEXT_LENGTH=8192
# Codex multi-agent orchestration is the default when the Responses API is
# configured. It runs specialist Agents concurrently, then a synthesis Agent.
# KOLFORGE_CONTENT_ANALYSIS_ORCHESTRATION=codex_multi_agent
# Bound simultaneous creator matrices and individual Responses requests. Raise
# only when the configured account's rate limits support the additional load.
# KOLFORGE_CONTENT_ANALYSIS_REMOTE_CONCURRENCY=2
# KOLFORGE_CONTENT_ANALYSIS_REQUEST_CONCURRENCY=6
# Each specialist and the synthesis Agent receive the same bounded local image
# bundle. These caps limit only request input size; OCR, ASR, and metadata stay
# available as citable evidence even when an image is skipped.
# KOLFORGE_CONTENT_ANALYSIS_MULTIMODAL_MAX_IMAGES=8
# KOLFORGE_CONTENT_ANALYSIS_MULTIMODAL_MAX_IMAGE_BYTES=4194304
# KOLFORGE_CONTENT_ANALYSIS_MULTIMODAL_MAX_TOTAL_BYTES=16777216
#
# Remote Responses API option. The API key remains server-only.
# KOLFORGE_CONTENT_ANALYSIS_PROVIDER=openai_responses
# KOLFORGE_CONTENT_ANALYSIS_MODEL=
# KOLFORGE_CONTENT_ANALYSIS_API_KEY=
# KOLFORGE_CONTENT_ANALYSIS_BASE_URL=https://api.openai.com/v1

# Local video evidence pipeline. It uses an actual <video> element rendered in
# the attached browser session, then FFprobe/FFmpeg and RapidOCR locally.
# Default: enabled, every captured public video per creator, 4 sampled frames per video.
# KOLFORGE_VIDEO_ANALYSIS_ENABLED=true
# Omit or set to all/0 to interpret every public video captured for a creator.
# KOLFORGE_VIDEO_ANALYSIS_SAMPLES_PER_CREATOR=all
# KOLFORGE_VIDEO_ANALYSIS_FRAMES_PER_VIDEO=4
# KOLFORGE_VIDEO_ANALYSIS_TIMEOUT_MS=180000
# Local post-observation workers. Browser pages remain serial to preserve the
# attached logged-in session; use 1-4 for local media/OCR/ASR processing.
# KOLFORGE_VIDEO_ANALYSIS_CONCURRENCY=2
# Parallel creator pipelines. Browser pages remain globally serial; this lets
# the next creator's page observation overlap with local processing work.
# KOLFORGE_VIDEO_CREATOR_CONCURRENCY=2
# Disabled by default because it records four seconds from every rendered
# player. Enable only when direct-media fallback coverage is more important
# than full-catalog throughput.
# KOLFORGE_VIDEO_BROWSER_RECORDING_FALLBACK=false
# KOLFORGE_VIDEO_FFMPEG_PATH=ffmpeg
# KOLFORGE_VIDEO_FFPROBE_PATH=ffprobe
# When present, the checked-in local runtime at .kolforge-runtime/python is
# selected automatically and includes RapidOCR plus onnxruntime. Override this
# only to point at another local Python environment with those packages installed.
# KOLFORGE_VIDEO_PYTHON=py
# KOLFORGE_VIDEO_PYTHON_ARGS=-3
# Optional local GGML Whisper model. Without it, visual/OCR analysis still runs
# and the audio role reports the transcript as unavailable.
# KOLFORGE_VIDEO_WHISPER_MODEL_PATH=
# KOLFORGE_VIDEO_WHISPER_LANGUAGE=zh
# Optional local Ollama vision pass over already extracted key frames. This is
# disabled unless a model name is explicitly configured. Qwen2.5-VL is a
# suitable local multimodal model; at most four frames are sent per video.
# KOLFORGE_VIDEO_VISION_MODEL=qwen2.5vl:3b
# KOLFORGE_VIDEO_VISION_BASE_URL=http://127.0.0.1:11434
# KOLFORGE_VIDEO_VISION_MAX_FRAMES=4
# KOLFORGE_VIDEO_VISION_TIMEOUT_MS=45000
# Four high-resolution frames need more than the common 4K VLM default context.
# KOLFORGE_VIDEO_VISION_CONTEXT_LENGTH=8192

# An attached browser profile is the default live connector for all three platforms.
# Log into the platform in that profile, then attach the OpenClaw Browser Relay.
# Browser CDP endpoint for the attached logged-in profile.
BROWSER_RELAY_PORT=18800
XIAOHONGSHU_RELAY_PORT=18800
# Douyin Relay is fixed in server/config.mjs at 18801; this line is retained for compatibility.
DOUYIN_RELAY_PORT=18801
DOUYIN_MESSAGE_CONNECTOR=browser_relay
DOUYIN_MESSAGE_RELAY_PORT=18801
DOUYIN_MESSAGE_TIMEOUT_MS=30000
# Opaque display label for that browser Profile. This is not a browser path,
# cookie, token, or account identifier.
KOLFORGE_BROWSER_PROFILE_ALIAS=attached-browser
# Non-secret Relay health snapshots; no cookies, tokens, URLs, or credentials
# are written here. The browser itself retains the encrypted login session.
# KOLFORGE_BROWSER_SESSION_STATE_DIR=.kolforge-data/browser-sessions
XIAOHONGSHU_CONNECTOR=browser_relay
XIAOHONGSHU_RELAY_SCRIPT=server/scripts/collect_xiaohongshu_relay.py
DOUYIN_CONNECTOR=browser_relay
DOUYIN_RELAY_SCRIPT=server/scripts/collect_douyin_relay.py
DOUYIN_SEARCH_URL_TEMPLATE=https://www.douyin.com/search/{query}?type=general
# Message delivery stays local until an application-owned server endpoint is configured.
# DOUYIN_MESSAGE_CONNECTOR=partner_http
# DOUYIN_MESSAGE_API_URL=http://127.0.0.1:9000/api/messages
# DOUYIN_MESSAGE_API_TOKEN=
# DOUYIN_MESSAGE_TIMEOUT_MS=30000
BILIBILI_CONNECTOR=browser_relay
BILIBILI_RELAY_SCRIPT=server/scripts/collect_bilibili_relay.py
BILIBILI_SEARCH_URL_TEMPLATE=https://search.bilibili.com/upuser?keyword={query}

# Optional: use the approved Douyin Open Platform video-search API instead of
# browser relay. Keep these values on the local API server only.
# DOUYIN_CONNECTOR=official_api
# DOUYIN_CLIENT_KEY=
# DOUYIN_CLIENT_SECRET=
# DOUYIN_DEVICE_ID=
# DOUYIN_SORT_TYPE=1
# DOUYIN_PUBLISH_TIME=180

# Optional: replace a platform connector with partner_http and configure a
# provider endpoint that accepts { platform, query, limit, mode } and returns an array.
# XIAOHONGSHU_CONNECTOR=partner_http
# XIAOHONGSHU_PARTNER_URL=https://provider.example.com/xiaohongshu/search
# XIAOHONGSHU_PARTNER_TOKEN=
# DOUYIN_CONNECTOR=partner_http
# DOUYIN_PARTNER_URL=https://provider.example.com/douyin/search
# DOUYIN_PARTNER_TOKEN=
# BILIBILI_CONNECTOR=partner_http
# BILIBILI_PARTNER_URL=https://provider.example.com/bilibili/search
# BILIBILI_PARTNER_TOKEN=

# Optional external video adapters. The API invokes each configured executable
# as a separate process and normalizes its output into the creator evidence matrix.
# video-batch-download receives: --input <urls.txt> --output <directory>.
# Keep its retry and page/media waits bounded so one unavailable public URL does
# not exhaust the whole creator-analysis run. --no-transcribe is deliberate:
# local Whisper and RapidOCR provide the shared evidence stages after download.
# KOLFORGE_VIDEO_BATCH_DOWNLOAD_COMMAND=node
# KOLFORGE_VIDEO_BATCH_DOWNLOAD_ARGS=["scripts/download.mjs","--no-transcribe","--max-attempts","1","--page-timeout","35","--media-wait","20","--download-timeout","240"]
# KOLFORGE_VIDEO_BATCH_DOWNLOAD_CWD=.kolforge-tools/video-batch-download
# KOLFORGE_VIDEO_BATCH_DOWNLOAD_TIMEOUT_MS=420000
# bilicli is Bilibili-only and receives: --json analyze <url> --output <directory>.
# The installed Windows adapter emits only normalized metadata/comment/danmaku
# evidence; downloaded media, ASR, and OCR remain on the local toolchain.
# KOLFORGE_BILICLI_COMMAND=node
# KOLFORGE_BILICLI_ARGS=[".kolforge-tools/bilicli/adapter.mjs"]
# KOLFORGE_BILICLI_CWD=.
# KOLFORGE_BILICLI_TIMEOUT_MS=360000
# video-copy-analyzer receives local media and an output directory. Its Windows
# adapter keeps UTF-8 process output and maps the upstream positional CLI.
# KOLFORGE_VIDEO_COPY_ANALYZER_COMMAND=venv\Scripts\python.exe
# KOLFORGE_VIDEO_COPY_ANALYZER_ARGS=["adapter.py"]
# KOLFORGE_VIDEO_COPY_ANALYZER_CWD=.kolforge-tools/video-copy-analyzer
# KOLFORGE_VIDEO_COPY_ANALYZER_TIMEOUT_MS=300000
# Built-in 302_video_summary provider. It uses the public source URL to obtain
# subtitles and returns a normalized summary, keypoints, and mind map. Supplying
# the server-only API key enables it automatically; set ENABLED=false to disable
# the provider and remove its missing-credential health signal.
# KOLFORGE_302_VIDEO_SUMMARY_ENABLED=true
# KOLFORGE_302_VIDEO_SUMMARY_API_KEY=
# KOLFORGE_302_VIDEO_SUMMARY_API_URL=https://api.302.ai
# KOLFORGE_302_VIDEO_SUMMARY_MODEL=gpt-4o
# KOLFORGE_302_VIDEO_SUMMARY_LANGUAGE=zh
# KOLFORGE_302_VIDEO_SUMMARY_REQUEST_TIMEOUT_MS=180000
# KOLFORGE_302_VIDEO_SUMMARY_MAX_TOKENS=900
# KOLFORGE_302_VIDEO_SUMMARY_TIMEOUT_MS=250000
# The summary bridge receives: --input <json> --output <json>.
# It must emit {"summary":"...","keypoints":["..."],"mindmap":{"label":"...","children":[]}}.
# KOLFORGE_VIDEO_SUMMARY_COMMAND=
# KOLFORGE_VIDEO_SUMMARY_ARGS=[]
# KOLFORGE_VIDEO_SUMMARY_CWD=
# KOLFORGE_VIDEO_SUMMARY_TIMEOUT_MS=250000
# Local Ollama bridge example (no external summary API is required):
# KOLFORGE_VIDEO_SUMMARY_COMMAND=node
# KOLFORGE_VIDEO_SUMMARY_ARGS=["server/scripts/summarize_video_local.mjs","--base-url","http://127.0.0.1:11434","--model","qwen2.5vl:3b","--timeout-ms","180000","--max-tokens","700"]
# KOLFORGE_VIDEO_SUMMARY_CWD=.
# KOLFORGE_VIDEO_SUMMARY_TIMEOUT_MS=250000
