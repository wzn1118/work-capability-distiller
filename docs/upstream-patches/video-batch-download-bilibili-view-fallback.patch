+  async _fetchViewFallback(page, url) {
+    const videoId = url.match(/\/video\/(BV[\w]+|av\d+)/i)?.[1] ?? null;
+    if (!videoId) return null;
+
+    const params = new URLSearchParams();
+    if (/^av\d+$/i.test(videoId)) params.set("aid", videoId.slice(2));
+    else params.set("bvid", videoId);
+
+    return this._fetchJsonFromPage(
+      page,
+      `https://api.bilibili.com/x/web-interface/view?${params.toString()}`,
+    );
+  }
