+test("Bilibili view fallback resolves BV and av URLs through the page API", async () => {
+  const parser = new BilibiliParser();
+  const requests = [];
+  parser._fetchJsonFromPage = async (_page, requestUrl) => {
+    requests.push(new URL(requestUrl));
+    return { code: 0, data: { title: "fixture" } };
+  };
+
+  await parser._fetchViewFallback({}, "https://www.bilibili.com/video/BV1fixture");
+  await parser._fetchViewFallback({}, "https://www.bilibili.com/video/av12345");
+
+  assert.equal(requests.length, 2);
+  assert.equal(requests[0].pathname, "/x/web-interface/view");
+  assert.equal(requests[0].searchParams.get("bvid"), "BV1fixture");
+  assert.equal(requests[1].searchParams.get("aid"), "12345");
+});
